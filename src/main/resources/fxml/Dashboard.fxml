<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hu.unideb.inf.warehouse.frontend.controller.DashboardController">

    <top>
        <Label text="Dashboard" BorderPane.alignment="CENTER">
            <font>
                <Font size="24.0" />
            </font>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </Label>
    </top>

    <center>
        <GridPane hgap="20" vgap="15">
            <padding><Insets top="20" left="20" right="20" bottom="20"/></padding>

            <Label text="Total products:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="totalProductsLabel" text="0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Total customers:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="totalCustomersLabel" text="0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Total orders:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="totalOrdersLabel" text="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Total revenue:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="totalRevenueLabel" text="0.00" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>
    </center>

</BorderPane>
