<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="586.0" prefWidth="1227.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hu.unideb.inf.warehouse.frontend.controller.MainPageController">

    <children>
        <BorderPane layoutX="2.0" prefHeight="636.0" prefWidth="1230.0">

            <!-- BAL OLDALI MENÜ -->
            <left>
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <children>
                        <Button text="Products" />
                        <Button text="Orders" />
                        <Button text="Sales" />
                        <Button text="Customers" />
                    </children>
               <padding>
                  <Insets left="10.0" right="10.0" top="50.0" />
               </padding>
                </VBox>
            </left>

            <!-- KÖZÉPSŐ TARTALOM -->
            <center>
                <VBox prefHeight="662.0" prefWidth="968.0">
                    <children>

                        <!-- TABLE + SEARCH SOR -->
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Items" />
                                <Region prefWidth="300" />
                                <TextField fx:id="searchField" promptText="Search...">
                           <HBox.margin>
                              <Insets right="10.0" />
                           </HBox.margin></TextField>
                                <Button onAction="#onSearch" text="Search" />
                            </children>
                     <padding>
                        <Insets bottom="10.0" top="10.0" />
                     </padding>
                        </HBox>

                        <!-- TÁBLA -->
                        <TableView fx:id="tableView" prefHeight="501.0" prefWidth="970.0">
                            <columns>
                                <TableColumn fx:id="colField1" text="Field1" />
                                <TableColumn fx:id="colField2" text="Field2" />
                                <TableColumn fx:id="colField3" text="Field3" />
                                <TableColumn fx:id="colField4" text="Field4" />
                            </columns>
                        </TableView>

                    </children>
                </VBox>
            </center>

            <!-- JOBB OLDAL -->
            <right>
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <children>
                        <Label text="Add/Remove item" />

                        <TextField fx:id="field1Input" promptText="Field1 Value" />
                        <TextField fx:id="field2Input" promptText="Field2 Value" />
                        <TextField fx:id="field3Input" promptText="Field3 Value" />
                        <TextField fx:id="field4Input" promptText="Field4 Value" />

                        <HBox alignment="CENTER">
                            <children>
                                <Button onAction="#onClear" text="Clear" />
                                <Region prefWidth="50" />
                                <Button onAction="#onAdd" text="Add" />
                            </children>
                        </HBox>

                        <Button onAction="#onRemove" text="Remove" />

                    </children>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
               <padding>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </padding>
                </VBox>
            </right>

        </BorderPane>
    </children>
</AnchorPane>
